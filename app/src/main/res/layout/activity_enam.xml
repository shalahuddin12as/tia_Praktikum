<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.pertemuan6.EnamActivity">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="#FC91D3F0"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:subtitleTextColor="@android:color/white"
      app:titleTextColor="@android:color/white"
      app:layout_scrollFlags="scroll|enterAlways"/>

  <Button
      android:id="@+id/btnFrag1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="16dp"
      android:text="Fragment 1"
      app:layout_constraintBottom_toBottomOf="@+id/btnFrag2"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="@+id/btnFrag2" />

  <Button
      android:id="@+id/btnFrag2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="16dp"
      android:layout_marginTop="44dp"
      android:text="Fragment 2"
      app:layout_constraintEnd_toStartOf="@+id/btnFrag3"
      app:layout_constraintHorizontal_bias="0.47"
      app:layout_constraintStart_toEndOf="@+id/btnFrag1"
      app:layout_constraintTop_toBottomOf="@+id/toolbar" />

  <Button
      android:id="@+id/btnFrag3"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="16dp"
      android:text="3Fragment 3"
      app:layout_constraintBottom_toBottomOf="@+id/btnFrag2"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@+id/btnFrag2" />

  <FrameLayout
      android:id="@+id/fragment_container"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/btnFrag2" />

</androidx.constraintlayout.widget.ConstraintLayout>